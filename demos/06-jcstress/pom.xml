<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pl.wsztajerowski</groupId>
        <artifactId>systematic-concurrency-testing-demos</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>06-jcstress</artifactId>


    <dependencies>
        <dependency>
            <groupId>pl.wsztajerowski</groupId>
            <artifactId>01-lamport-volatile</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>pl.wsztajerowski</groupId>
            <artifactId>02-lamport-single-thread</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>pl.wsztajerowski</groupId>
            <artifactId>03-lamport-lock</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jcstress</groupId>
            <artifactId>jcstress-core</artifactId>
            <version>${jcstress.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Explicit annotation-processor path so the JCStressTestProcessor
                 generates test-runner infrastructure classes during compilation. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jcstress</groupId>
                            <artifactId>jcstress-core</artifactId>
                            <version>${jcstress.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Build a self-contained fat jar that the jcstress harness can execute. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>main</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>jcstress</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jcstress.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/CompilerHints</resource>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Run jcstress during integration-test phase (after the fat jar is built).
                 add-opens flags are required by jcstress internals on Java 17+. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <!-- Everything NOT under .jcstress.edgecase. — i.e. every test expected to
                         pass. A non-zero exit here means a real regression, so the default strict
                         exit-code check applies. A test that forgets its subpackage lands here and
                         fails loudly rather than silently running nowhere. -->
                    <execution>
                        <id>run-jcstress</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>--add-opens</argument>
                                <argument>java.base/jdk.internal.misc=ALL-UNNAMED</argument>
                                <argument>--add-opens</argument>
                                <argument>java.base/java.lang=ALL-UNNAMED</argument>
                                <argument>--add-opens</argument>
                                <argument>java.base/sun.nio.ch=ALL-UNNAMED</argument>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/jcstress.jar</argument>
                                <argument>-r</argument>
                                <argument>${project.build.directory}/jcstress-results</argument>
                                <argument>-t</argument>
                                <argument>^(?!.*\.edgecase\.).*</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Tests under .jcstress.edgecase. are intentionally broken demos: observing
                         the FORBIDDEN outcome IS the point, and jcstress exits 1 when it does, so
                         that exit code is tolerated here and nowhere else. Add a new failing demo by
                         putting it in that package — no change to this pom. Read the report under
                         target/jcstress-results-expected-failures. -->
                    <execution>
                        <id>run-jcstress-expected-failures</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>--add-opens</argument>
                                <argument>java.base/jdk.internal.misc=ALL-UNNAMED</argument>
                                <argument>--add-opens</argument>
                                <argument>java.base/java.lang=ALL-UNNAMED</argument>
                                <argument>--add-opens</argument>
                                <argument>java.base/sun.nio.ch=ALL-UNNAMED</argument>
                                <argument>-jar</argument>
                                <argument>${project.build.directory}/jcstress.jar</argument>
                                <argument>-r</argument>
                                <argument>${project.build.directory}/jcstress-results-expected-failures</argument>
                                <argument>-t</argument>
                                <argument>\.jcstress\.edgecase\.</argument>
                            </arguments>
                            <successCodes>
                                <successCode>0</successCode>
                                <successCode>1</successCode>
                            </successCodes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
