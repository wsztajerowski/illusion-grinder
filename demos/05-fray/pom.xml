<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pl.wsztajerowski</groupId>
        <artifactId>illusion-grinder-demos</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>05-fray</artifactId>

    <dependencies>
        <dependency>
            <groupId>pl.wsztajerowski</groupId>
            <artifactId>00-lamport</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>pl.wsztajerowski</groupId>
            <artifactId>01-lamport-volatile</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>pl.wsztajerowski</groupId>
            <artifactId>02-lamport-single-thread</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>pl.wsztajerowski</groupId>
            <artifactId>03-lamport-lock</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pastalab.fray</groupId>
            <artifactId>fray-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pastalab.fray</groupId>
            <artifactId>fray-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pastalab.fray</groupId>
            <artifactId>fray-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.pastalab.fray.maven</groupId>
                <artifactId>fray-plugins-maven</artifactId>
                <executions>
                    <execution>
                        <id>prepare-fray</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-fray</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <fray.organize.by.test>true</fray.organize.by.test>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

